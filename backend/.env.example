APP_ENV=development
APP_API_KEY=replace-with-a-long-random-local-secret
DEV_USER_ID=local-user
DATABASE_URL=sqlite+aiosqlite:///./expenses.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI capabilities (Get your API key from https://aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key-here
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=transactions

# PostgreSQL (used in Docker Compose / production)
POSTGRES_DB=expenses
POSTGRES_USER=expenses
POSTGRES_PASSWORD=local-only-change-me

# Authentication & Security
JWT_SECRET_KEY=replace-with-a-secure-random-jwt-secret-key-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google Identity Services / OAuth (Optional)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
